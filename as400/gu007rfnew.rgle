// *==========================================================================================
// *
// * Instructions
// * ------------
// * There should be three files:
// *  GU007D     *FILE        (DSPF)
// *  GU007RFREE *PGM/*MODULE (RPGLE)
// *  GU007CFREE *PGM         (CLLE)
// *
// * Compile GU007CFREE as program. Compile GU007D as per normal.
// * Compile GU007RFREE as module (CRTRPGMOD). Then type the following:
// *  CRTPGM PGM(GU007RFREE) MODULE(GU007RFREE) BNDDIR(QC2LE) ACTGRP(*CALLER) ALWLIBUPD(*YES)
// *
// * When running the program, make sure you have QTEMP in your library list.
// *  CALL PGM(GU007CFREE)
// *
// *==========================================================================================

Ctl-Opt AltSeq(*None) BndDir('QC2LE');

Dcl-F Gu007D workstn;

// Prototype procedure
Dcl-Pr GetRandom Int(10) ExtProc('rand');
End-Pr;

Dcl-Pr Sleep ExtProc('usleep');
    SleepTime Int(10) Value;
End-Pr;

// System status data structure
Dcl-Ds *n PSDS;
    QMsgTyp Char(3) Pos(40);
    QMsgNbr Char(4) Pos(43);
End-Ds;

Dcl-C ScreenHeight Const(10);
Dcl-C ScreenWidth Const(50);
Dcl-C ScreenNChars Const(500); // Width x Height

// Local variables
// Informations on snake's Position
Dcl-Ds *n Len(ScreenNChars) Inz;
    SnakePos_Arr Char(1) Dim(ScreenNChars);
    SnakePos_Char Char(ScreenNChars) Pos(1);
End-Ds;

Dcl-Ds Snake qualified Dim(2) Inz;
    // Information on snake's Position
    Cur_X Int(10);
    Cur_Y Int(10);
    Length Int(10);
    Grow Int(10);
    Heading Char(1);

    Prev_X Int(10) Dim(500);
    Prev_Y Int(10) Dim(500);
    Prev_Cnt Int(10);

    Score Int(10);
End-Ds;

Dcl-S Snake_Food Int(10) Inz(*Zeros);
Dcl-S Snake_Food_X Int(10) Inz(*Zeros);
Dcl-S Snake_Food_Y Int(10) Inz(*Zeros);

Dcl-S Cnt Int(10) Inz(*Zeros);

Dcl-S Ind_EndGame Ind Inz(*Off);

// General calculations
Dcl-S Pos_X Int(10) Inz(*Zeros);
Dcl-S Pos_Y Int(10) Inz(*Zeros);
Dcl-S Result Int(10) Inz(*Zeros);
Dcl-S Time_LstMove Timestamp Inz;
Dcl-S Time_CurMove Timestamp Inz;
Dcl-S Time_Secs Int(10) Inz(*Zeros);
Dcl-S Temp_Rand Int(10) Inz(*Zeros);
Dcl-S Add_To_Tail Int(10) Inz(*Zeros);

// Use with data queue
Dcl-S QNam Char(10) Inz('GU007DQ');
Dcl-S QLib Char(10) Inz('*LIBL');
Dcl-S QLen Packed(5) Inz(*Zeros);
Dcl-S QMsg Char(640) Inz(*Blanks);
Dcl-S QWait Packed(5) Inz(1);

// Use with sleep
Dcl-C SleepTime Const(300000);

// Parameters list
Dcl-Pr WrcvDtaq ExtPgm('QRCVDTAQ');
    *n like(QNam);
    *n like(QLib);
    *n like(QLen);
    *n like(QMsg);
    *n like(QWait);
End-Pr;

// For #Repeat Tag in main program
Dcl-S Repeat_Exit Ind Inz(*Off);

// Main logic
ExSr SrInit;

DoW (*In03 = *Off) And (*In12 = *Off);
    ExSr SrPutToScreen;

    Write(E) D01;
    *In31 = %error;
    If (*In31 = *On) And (QMsgTyp = 'CPF' And QMsgNbr = '4737');
        Read D01;
    EndIf;

    ExSr SrReadDataQueue;

    Reset Repeat_Exit;
    DoW *On; // #Repeat Tag
        If (QLen > *Zeros);
            Read D01;
            If (*In03 = *On) Or (*In12 = *On);
                Repeat_Exit = *On;
                Leave;
            EndIf;
        Else;
            Sleep(SleepTime);
            ExSr SrReadDataQueue;
            If (QLen > *Zeros);
               Iter;
            EndIf;
        EndIf;

        Leave;
    EndDo;
    If (Repeat_Exit = *On);
        Leave;
    EndIf;

    If (Ind_EndGame = *Off);
        Time_CurMove = %timestamp(*UNIQUE);
        Time_Secs = %diff(Time_CurMove : Time_LstMove : *Ms);
        If (Time_Secs >= 299999);
            ExSr SrCheckMove;
            ExSr SrAutoMove;
        EndIf;
    EndIf;
EndDo;
*Inlr = *On;
Return;

// SrCheckMove Sub Routine
// Check movement made
BegSr SrCheckMove;
    Time_LstMove = (Time_CurMove);

    Select;
        When (WInput = 'I') And (Snake(1).Heading <> 'S');
            Snake(1).Heading = 'N';

        When (WInput = 'K') And (Snake(1).Heading <> 'N');
            Snake(1).Heading = 'S';

        When (WInput = 'J') And (Snake(1).Heading <> 'E');
            Snake(1).Heading = 'W';

        When (WInput = 'L') And (Snake(1).Heading <> 'W');
            Snake(1).Heading = 'E';
    EndSl;
EndSr;

// SrAutoMove Sub Routine
// Automatically move the snake forward
BegSr SrAutoMove;
    For Cnt = 1 To 2;
        Snake(Cnt).Cur_X = (Snake(Cnt).Prev_X(1));
        Snake(Cnt).Cur_Y = (Snake(Cnt).Prev_Y(1));

        If Cnt = 2; // Opponent
            // Find out where to move next
            Snake_Food_X = Snake_Food / ScreenWidth;
            Snake_Food_Y = %Rem(Snake_Food : ScreenWidth);

            If ((Snake(Cnt).Cur_X - 1) = Snake_Food_X);
                If (Snake(Cnt).Cur_Y < Snake_Food_Y);
                    Snake(Cnt).Heading = 'E';
                ElseIf (Snake(Cnt).Cur_Y > Snake_Food_Y);
                    Snake(Cnt).Heading = 'W';
                EndIf;
            ElseIf (Snake(Cnt).Cur_Y = Snake_Food_Y);
                If ((Snake(Cnt).Cur_X - 1) < Snake_Food_X);
                    Snake(Cnt).Heading = 'S';
                ElseIf ((Snake(Cnt).Cur_X - 1) > Snake_Food_X);
                    Snake(Cnt).Heading = 'N';
                EndIf;
            EndIf;
        EndIf;

        Select Snake(Cnt).Heading;
            When-Is 'N';
                Snake(Cnt).Cur_X -= 1;
                If (Snake(Cnt).Cur_X < 1);
                    Snake(Cnt).Cur_X = ScreenHeight;
                EndIf;

            When-Is 'S';
                Snake(Cnt).Cur_X += 1;
                If (Snake(Cnt).Cur_X > ScreenHeight);
                    Snake(Cnt).Cur_X = 1;
                EndIf;

            When-Is 'W';
                Snake(Cnt).Cur_Y -= 1;
                If (Snake(Cnt).Cur_Y < 1);
                    Snake(Cnt).Cur_Y = ScreenWidth;
                EndIf;

            When-Is 'E';
                Snake(Cnt).Cur_Y += 1;
                If (Snake(Cnt).Cur_Y > ScreenWidth);
                    Snake(Cnt).Cur_Y = 1;
                EndIf;
        EndSl;

        If Cnt = 1;
            // Clear the previous buffer
            Clear SnakePos_Char;
            ExSr SrPlaceFood;
        EndIf;

        // Get current position
        // Move the body only
        If (Snake(Cnt).Grow > *Zeros);
            If (Add_To_Tail = (Snake(Cnt).Length - 1));
                Add_To_Tail = *Zeros;
                Snake(Cnt).Prev_X(Snake(Cnt).Length + 1) = Snake(Cnt).Prev_X(Snake(Cnt).Length);
                Snake(Cnt).Prev_Y(Snake(Cnt).Length + 1) = Snake(Cnt).Prev_Y(Snake(Cnt).Length);
                Result = GetResult(
                    Snake(Cnt).Prev_X(Snake(Cnt).Length + 1) :
                    Snake(Cnt).Prev_Y(Snake(Cnt).Length + 1)
                );
                If Cnt = 1;
                    SnakePos_Arr(Result) = ('o');
                ElseIf Cnt = 2;
                    SnakePos_Arr(Result) = ('x');
                EndIf;
            Else;
                Add_To_Tail += 1;
            EndIf;
        EndIf;

        For Snake(Cnt).Prev_Cnt = Snake(Cnt).Length DownTo 2;
            Snake(Cnt).Prev_X(Snake(Cnt).Prev_Cnt) = Snake(Cnt).Prev_X(Snake(Cnt).Prev_Cnt - 1);
            Snake(Cnt).Prev_Y(Snake(Cnt).Prev_Cnt) = Snake(Cnt).Prev_Y(Snake(Cnt).Prev_Cnt - 1);
            Result = GetResult(
                Snake(Cnt).Prev_X(Snake(Cnt).Prev_Cnt) :
                Snake(Cnt).Prev_Y(Snake(Cnt).Prev_Cnt)
            );
            If Cnt = 1;
                SnakePos_Arr(Result) = ('o');
            ElseIf Cnt = 2;
                SnakePos_Arr(Result) = ('x');
            EndIf;
        EndFor;

        If (Snake(Cnt).Grow > *Zeros) And (Add_To_Tail = *Zeros);
            Snake(Cnt).Grow -= 1;
            Snake(Cnt).Length += 1;
            If (Snake(Cnt).Grow > *Zeros);
                Add_To_Tail += 1;
            EndIf;
        EndIf;

        // Move head
        Snake(Cnt).Prev_X(1) = (Snake(Cnt).Cur_X);
        Snake(Cnt).Prev_Y(1) = (Snake(Cnt).Cur_Y);
        Result = GetResult(Snake(Cnt).Prev_X(1) : Snake(Cnt).Prev_Y(1));
        If (SnakePos_Arr(Result) <> (*Blanks));
            BlockUsed(Cnt);
        EndIf;

        If (Ind_EndGame = *On);
            WStatus = 'GAME OVER';
        EndIf;
        If Cnt = 1;
            SnakePos_Arr(Result) = ('$');
        ElseIf Cnt = 2;
            SnakePos_Arr(Result) = ('@');
        EndIf;

        If Cnt = 1;
            // Place food block
            ExSr SrPlaceFood;
        EndIf;
    EndFor;
EndSr;

// SrPutToScreen Sub Routine
// Move program data to display
BegSr SrPutToScreen;
    // Move the block elements
    WLine01 = (%Subst(SnakePos_Char : 001 : ScreenWidth));
    WLine02 = (%Subst(SnakePos_Char : 051 : ScreenWidth));
    WLine03 = (%Subst(SnakePos_Char : 101 : ScreenWidth));
    WLine04 = (%Subst(SnakePos_Char : 151 : ScreenWidth));
    WLine05 = (%Subst(SnakePos_Char : 201 : ScreenWidth));
    WLine06 = (%Subst(SnakePos_Char : 251 : ScreenWidth));
    WLine07 = (%Subst(SnakePos_Char : 301 : ScreenWidth));
    WLine08 = (%Subst(SnakePos_Char : 351 : ScreenWidth));
    WLine09 = (%Subst(SnakePos_Char : 401 : ScreenWidth));
    WLine10 = (%Subst(SnakePos_Char : 451 : ScreenWidth));

    // Move score information
    WScore = Snake(1).Score;
    WScor2 = Snake(2).Score;
    WLength = Snake(1).Length;
    WLengt2 = Snake(2).Length;
EndSr;

// SrPlaceFood Sub Routine
// Place food for snake
BegSr SrPlaceFood;
    Select Snake_Food;
        // First Class meals = 10 points
        // (You've got to fly Singapore Airlines to know what I mean !)
        When-In %list(123 : 456 : 321 : 497 : 135 : 498 : 246 : 155 : 255 : 355 : 455 : 122 : 322 :
                      331);
             SnakePos_Arr(Snake_Food) = ('F');

        // Raffles Class or Business Class meals = 5 points
        // (You've got to fly Singapore Airlines to know what I mean !)
        When-In %list(011 : 022 : 033 : 044 : 055 : 066 : 077 : 088 : 099 : 111 : 222 : 333 : 444 :
                      499);
            SnakePos_Arr(Snake_Food) = ('C');

        // Economy Class meals = 1 point
        Other;
            SnakePos_Arr(Snake_Food) = ('Y');
    EndSl;
EndSr;

// SrInit Sub Routine
// Program initialize routine
BegSr SrInit;
    // Initialize snake length
    Snake(1).Length = 2;
    Snake(2).Length = 2;

    // Initialize snake position
    // Get head
    Pos_X = 5;
    Pos_Y = 25;
    Result = GetResult(Pos_X : Pos_Y);
    SnakePos_Arr(Result) = ('$');
    // Get body
    Pos_X = 6;
    Pos_Y = 25;
    Result = GetResult(Pos_X : Pos_Y);
    SnakePos_Arr(Result) = ('o');

    // Get head
    Pos_X = 3;
    Pos_Y = 23;
    Result = GetResult(Pos_X : Pos_Y);
    SnakePos_Arr(Result) = ('@');
    // Get body
    Pos_X = 2;
    Pos_Y = 23;
    Result = GetResult(Pos_X : Pos_Y);
    SnakePos_Arr(Result) = ('x');

    // Initialize snake path
    Snake(1).Heading = 'N';
    Snake(1).Prev_X(1) = 5;
    Snake(1).Prev_Y(1) = 25;
    Snake(1).Prev_X(2) = 6;
    Snake(1).Prev_Y(2) = 25;

    Snake(2).Heading = 'S';
    Snake(2).Prev_X(1) = 3;
    Snake(2).Prev_Y(1) = 23;
    Snake(2).Prev_X(2) = 2;
    Snake(2).Prev_Y(2) = 23;

    // Get time
    Time_LstMove = %timestamp(*UNIQUE);

    // Get food back
    SrRand();
    ExSr SrPlaceFood;
EndSr;

BegSr SrReadDataQueue;
    QLen = *Zeros;
    QMsg = *Blanks;
    QWait = *Zeros;
    WrcvDtaq(QNam : QLib : QLen : QMsg : QWait);
EndSr;

// SrBlockUsed Procedure
// Check if the block is already occupied
Dcl-Proc BlockUsed;
    Dcl-Pi *n;
        Cnt Int(10) Const;
    End-Pi;

    Select SnakePos_Arr(Result);
        // Economy Class points
        When-Is 'Y';
            Snake(Cnt).Score += 1;
            Snake(Cnt).Grow += 1;
            SrRand();

        // Raffles Class or Business Class points
        When-Is 'C';
            Snake(Cnt).Score += 8;
            Snake(Cnt).Grow += 1;
            SrRand();

        // First Class points
        When-Is 'F';
            Snake(Cnt).Score += 10;
            Snake(Cnt).Grow += 1;
            SrRand();

        // The snake ran into itself, game over !
        Other;
            Ind_EndGame = *On;
    EndSl;
End-Proc;

Dcl-Proc GetResult;
    Dcl-Pi *n Int(10);
        X Int(10) Value;
        Y Int(10) Value;
    End-Pi;

    return ScreenWidth * (X - 1) + Y;
End-Proc;

// SrRand Sub Routine
// Generate random number using ILE C function
Dcl-Proc SrRand;
    Snake_Food = *Zeros;

    Dow *On;
        Temp_Rand = (GetRandom());
        If (Temp_Rand > 1001);
            Temp_Rand /= ScreenWidth;
        EndIf;

        Temp_Rand = %Rem(Temp_Rand : ScreenNChars);

        If SnakePos_Arr(Temp_Rand) = (*Blanks);
            Snake_Food = Temp_Rand;
        EndIf;

        If (Snake_Food = *Zeros);
            Iter;
        EndIf;

        Leave;
    EndDo;
End-Proc;
